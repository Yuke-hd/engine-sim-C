# Copy to local.env (gitignored) and fill in. Values already in the environment win.
BUNDLE_ID=${BUNDLE_ID:-com.example.enginesimtester}  # must match a provisioning profile
IDENTITY=${IDENTITY:-"Apple Development: you@example.com (XXXXXXXXXX)"}  # security find-identity -v -p codesigning
TEAM=${TEAM:-XXXXXXXXXX}  # Apple development team ID (install.sh only)
DEVICE=${DEVICE:-00000000-0000-0000-0000-000000000000}  # xcrun devicectl list devices
